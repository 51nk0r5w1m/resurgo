# Generated values belong in .env. Run `pnpm env:init`; do not use these placeholders.
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
BETTER_AUTH_SECRET=replace-me-with-a-random-local-secret-at-least-32-characters

SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=no-reply@resurgo.local

POSTGRES_USER=resurgo
POSTGRES_PASSWORD=replace-me-with-a-random-local-secret
POSTGRES_DB=resurgo
POSTGRES_PORT=5432
DATABASE_URL=postgresql://resurgo:replace-me-with-a-random-local-secret@127.0.0.1:5432/resurgo

GARAGE_ENDPOINT=http://127.0.0.1:3900
GARAGE_PORT=3900
GARAGE_REGION=garage
GARAGE_BUCKET=resurgo-local-private
GARAGE_ACCESS_KEY_ID=GKREPLACEWITHARANDOMLOCALKEY000000
GARAGE_SECRET_ACCESS_KEY=replace-me-with-a-random-local-secret
